# web_server.fl
# Example FlameLang manifest for a simple web server

container SimpleWebServer {
    glyph: [100]          # Compiler Core - transformation
    image: "alpine:latest"
    
    # Volume for web content
    volumes: [
        "/var/www" -> sovereign_volume("web_content")
    ]
    
    # Setup and run web server
    cmd: [528] -> {
        # Install Python
        apk add --no-cache python3
        
        # Create content
        mkdir -p /var/www
        echo "<h1>🔥 Sovereign Web Server ⚔️🖤</h1>" > /var/www/index.html
        
        # Start server
        cd /var/www
        python3 -m http.server 8000
    }
    
    # Higher resources for transformation frequency
    resources: {
        memory: 1G @frequency(528Hz)
        cpu: 2 @frequency(528Hz)
    }
}

network web_network {
    glyph: [200]
    type: "bridge"
    subnet: "10.200.0.0/16"
}

deploy [001]
