{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UDAP - Universal Data Access Protocol",
  "description": "Sovereign protocol for pure methodology routing",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "skhaos",
      "description": "Protocol identifier"
    },
    "domain": {
      "type": "string",
      "enum": ["pure", "hybrid", "legacy"],
      "description": "Purity domain level"
    },
    "category": {
      "type": "string",
      "enum": [
        "tcp",
        "browser",
        "compiler",
        "alpha",
        "protein",
        "collapse",
        "hybrid",
        "atom",
        "dna",
        "wave"
      ],
      "description": "Operation category"
    },
    "resource": {
      "type": "string",
      "description": "Specific resource identifier"
    },
    "parameters": {
      "type": "object",
      "properties": {
        "hz": {
          "type": "number",
          "minimum": 0,
          "description": "Operating frequency in Hertz"
        },
        "purge": {
          "type": "boolean",
          "description": "Enable dependency purging"
        },
        "own_binary": {
          "type": "boolean",
          "description": "Use sovereign trinary binary"
        },
        "own_dna": {
          "type": "boolean",
          "description": "Use DNA vectorization"
        },
        "vector": {
          "type": "boolean",
          "description": "Enable vector embeddings"
        },
        "collapse": {
          "type": "boolean",
          "description": "Enable wave function collapse"
        },
        "inventory": {
          "type": "boolean",
          "description": "Perform function inventory"
        },
        "alpha_dna": {
          "type": "string",
          "description": "Alphabet to DNA mapping text"
        },
        "fold": {
          "type": "boolean",
          "description": "Enable protein folding"
        }
      }
    }
  },
  "required": ["protocol", "domain", "category"],
  "examples": [
    {
      "uri": "skhaos://pure/tcp/handshake?own_binary=true&hz=20000",
      "description": "Pure TCP handshake with sovereign binary at 20kHz"
    },
    {
      "uri": "skhaos://pure/browser/interact?purge=true&hz=100000",
      "description": "Browser automation with purged dependencies at 100kHz"
    },
    {
      "uri": "skhaos://pure/compiler/ir?own_binary=true&hz=30000",
      "description": "Trinary IR compilation at 30kHz"
    },
    {
      "uri": "skhaos://pure/alpha/dna/SOVEREIGNTY?vector=true&hz=1000",
      "description": "Alphabet to DNA vectorization at 1kHz"
    },
    {
      "uri": "skhaos://pure/collapse/protein?hz=25000&fold=true",
      "description": "Wave function collapse with protein folding at 25kHz"
    }
  ],
  "definitions": {
    "frequency_ranges": {
      "dna_vector": 1000,
      "tcp_inventory": 20000,
      "collapse_helm": 25000,
      "compile_own": 30000,
      "purge_browser": 100000
    },
    "purity_levels": {
      "legacy": 0,
      "hybrid": 50,
      "pure": 100
    },
    "sovereign_elements": {
      "description": "Periodic table of sovereign operations",
      "count": 20,
      "extensible_to": 118
    }
  }
}
