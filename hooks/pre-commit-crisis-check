#!/bin/bash
# Pre-commit Crisis Check - Prevents "nobody mode" by tracking artifacts
# Crisis hook runs before commit to ensure inventory is synchronized

REPO_ROOT="$(git rev-parse --show-toplevel)"
CRISIS_SCRIPT="${REPO_ROOT}/scripts/crisis_recovery.sh"

# Run crisis recovery check before commit
if [ -x "${CRISIS_SCRIPT}" ]; then
    echo "🔍 Running crisis recovery check..."
    bash "${CRISIS_SCRIPT}"
    
    # Note: high_score.txt is NOT automatically staged by this hook
    # This prevents unintended staging during commits
    # To commit high_score.txt, manually stage it: git add high_score.txt
else
    echo "⚠️  Crisis recovery script not found or not executable"
    echo "   Expected: ${CRISIS_SCRIPT}"
fi

# Always allow commit to proceed
exit 0
