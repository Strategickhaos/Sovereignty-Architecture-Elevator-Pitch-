{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://strategickhaos.dev/schemas/agent.schema.json",
  "title": "Sovereign Compute Stack Agent Schema",
  "description": "Schema for defining agents in the Sovereign Compute Stack genome",
  "version": "1.0.0",
  "type": "object",
  "required": ["agent", "metadata", "purpose", "capabilities", "interfaces"],
  "properties": {
    "agent": {
      "type": "object",
      "required": ["id", "name", "version", "type"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Unique identifier for the agent (lowercase, underscores allowed)"
        },
        "name": {
          "type": "string",
          "description": "Human-readable name for the agent"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version of the agent (e.g., 1.0.0)"
        },
        "type": {
          "type": "string",
          "description": "Classification of the agent's primary function"
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["created", "maintainer", "pillars"],
      "properties": {
        "created": {
          "type": "string",
          "format": "date",
          "description": "Creation date in YYYY-MM-DD format"
        },
        "maintainer": {
          "type": "string",
          "description": "Organization or individual maintaining this agent"
        },
        "pillars": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["OS", "LANG", "BIO", "VERIF"]
          },
          "minItems": 1,
          "description": "Architecture pillars this agent supports"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of required dependencies"
        }
      }
    },
    "purpose": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": {
          "type": "string",
          "description": "Primary purpose of the agent"
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Secondary functions and capabilities"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "Detailed capabilities and features of the agent",
      "additionalProperties": true
    },
    "interfaces": {
      "type": "object",
      "required": ["input", "output"],
      "properties": {
        "input": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "protocol", "format"],
            "properties": {
              "type": {
                "type": "string",
                "description": "Type of input interface"
              },
              "protocol": {
                "type": "string",
                "description": "Communication protocol"
              },
              "format": {
                "type": "string",
                "description": "Data format specification"
              },
              "source": {
                "type": "string",
                "description": "Source system or component"
              }
            }
          },
          "minItems": 1,
          "description": "Input interfaces"
        },
        "output": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "protocol", "format"],
            "properties": {
              "type": {
                "type": "string",
                "description": "Type of output interface"
              },
              "protocol": {
                "type": "string",
                "description": "Communication protocol"
              },
              "format": {
                "type": "string",
                "description": "Data format specification"
              },
              "destination": {
                "type": "string",
                "description": "Destination system or component"
              }
            }
          },
          "minItems": 1,
          "description": "Output interfaces"
        }
      }
    },
    "verification": {
      "type": "object",
      "description": "Verification and validation requirements",
      "properties": {
        "legion_integration": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "verification_scope": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "challenge_frequency": {
              "type": "string"
            }
          }
        },
        "trig6_stress_test": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "frequency": {
              "type": "string"
            },
            "thresholds": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "metric": {
                    "type": "string"
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "love_invariant_checks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Love Invariant ethical constraints to verify"
        }
      }
    },
    "performance": {
      "type": "object",
      "description": "Performance characteristics and targets",
      "additionalProperties": true
    },
    "monitoring": {
      "type": "object",
      "description": "Monitoring and observability configuration",
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dashboards": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "condition": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"]
              },
              "destination": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "integration": {
      "type": "object",
      "description": "Integration points with other systems",
      "additionalProperties": true
    },
    "error_handling": {
      "type": "object",
      "description": "Error handling and recovery policies",
      "properties": {
        "policy": {
          "type": "string"
        },
        "fallback_mode": {
          "type": "string"
        },
        "alert_channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "automation": {
      "type": "object",
      "description": "Automation and scheduling configuration",
      "properties": {
        "scheduled_tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task": {
                "type": "string"
              },
              "frequency": {
                "type": "string"
              },
              "schedule": {
                "type": "string"
              }
            }
          }
        },
        "notifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event": {
                "type": "string"
              },
              "channel": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
