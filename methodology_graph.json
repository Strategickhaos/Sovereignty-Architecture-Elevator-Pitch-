    ["03-H-WebApp", "05-Aa-Creds"],
    ["04-Z-Exploit", "05-Aa-Creds"],
    ["04-Z-Exploit", "06-Ab-PrivEsc"],
    ["05-Aa-Creds", "06-Ab-PrivEsc"],
    ["05-Aa-Creds", "09-F-Pivot"],
    ["06-Ab-PrivEsc", "07-E-Persist"],
