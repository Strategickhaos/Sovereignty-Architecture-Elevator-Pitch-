namespace flame::homeostasis::gradient {
    
    /**
     * Gradient Type Definitions
     */
    enum GradientType {
        Proton,   // Push forces (positive gradient)
        Electron  // Pull forces (negative gradient)
    }
    
    struct Gradient {
        type: GradientType,
        magnitude: f64,
        direction: Vector3,
        source: String,
        timestamp: DateTime
    }
    
    /**
     * The Gradient Reconciler
     * 
     * Core GSCH Implementation:
     * When Proton (Push) and Electron (Pull) gradients are mismatched,
     * the system automatically triggers a 'Dissolve' event rather than
     * allowing a crash to propagate.
     */
    pub fn reconcile_gradients(protons: Vec<Gradient>, electrons: Vec<Gradient>) 
        -> Result<EquilibriumState, DissolveEvent> {
        
        // Calculate net gradient vectors
        let net_push = protons.iter()
            .map(|p| p.magnitude * p.direction)
            .sum();
        
        let net_pull = electrons.iter()
            .map(|e| e.magnitude * e.direction)
            .sum();
        
        // Check for unit mismatch (type safety violation)
        if !units_match(&net_push, &net_pull) {
            return Err(DissolveEvent::UnitMismatch {
                proton_units: get_units(&net_push),
                electron_units: get_units(&net_pull),
                error_msg: "Cannot reconcile incompatible gradient units"
            });
        }
        
        // Calculate equilibrium point
        let equilibrium = (net_push + net_pull) / 2.0;
        
        // Check if within homeostatic bounds
        if equilibrium.magnitude() > MAX_GRADIENT_MAGNITUDE {
            return Err(DissolveEvent::ExcessiveGradient {
                magnitude: equilibrium.magnitude(),
                threshold: MAX_GRADIENT_MAGNITUDE,
                suggestion: "Reduce system load or increase buffer capacity"
            });
        }
        
        Ok(EquilibriumState {
            gradient: equilibrium,
            stability: calculate_stability(&protons, &electrons),
            energy_delta: calculate_energy_delta(&net_push, &net_pull)
        })
    }
    
    /**
     * Dissolve Event Handler
     * 
     * Instead of crashing, the system gracefully dissolves the
     * mismatched computation and returns energy to the available pool.
     * 
     * This implements the "Dissolution Protocol" from Phase II, Question 12.
     */
    pub fn handle_dissolve_event(event: DissolveEvent) {
        match event {
            DissolveEvent::UnitMismatch { proton_units, electron_units, error_msg } => {
                log::error!("Unit mismatch in gradient reconciliation");
                log::error!("  Proton units: {:?}", proton_units);
                log::error!("  Electron units: {:?}", electron_units);
                log::error!("  Message: {}", error_msg);
                
                // Return energy (memory) to available pool
                lifecycle::dissolve(proton_units);
                lifecycle::dissolve(electron_units);
                
                // Trigger Legion of Minds review
                council::request_review("Gradient unit mismatch detected");
            },
            
            DissolveEvent::ExcessiveGradient { magnitude, threshold, suggestion } => {
                log::warn!("Excessive gradient magnitude detected");
                log::warn!("  Magnitude: {}", magnitude);
                log::warn!("  Threshold: {}", threshold);
                log::warn!("  Suggestion: {}", suggestion);
                
                // Apply clamping (Sodium/Potassium Pump from Phase II, Question 10)
                primitives::clamp::eject_excess(magnitude - threshold);
                
                // Notify monitoring system
                monitoring::alert("Gradient exceeded homeostatic bounds");
            }
        }
    }
    
    /**
     * Unit System for Gradients
     * 
     * Ensures type safety at the physics level. You cannot add
     * gradients with incompatible units (e.g., voltage + current).
     */
    enum Unit {
        Voltage,      // Electrical potential
        Current,      // Electron flow
        Pressure,     // Mechanical force
        Temperature,  // Thermal energy
        Entropy,      // Information/disorder
        Energy        // General work capacity
    }
    
    fn units_match(v1: &Vector3, v2: &Vector3) -> bool {
        v1.unit == v2.unit
    }
    
    /**
     * Stability Calculation
     * 
     * Measures how balanced the system is. High stability = good homeostasis.
     */
    fn calculate_stability(protons: &Vec<Gradient>, electrons: &Vec<Gradient>) -> f64 {
        let total_magnitude = protons.iter().map(|p| p.magnitude).sum::<f64>()
                            + electrons.iter().map(|e| e.magnitude).sum::<f64>();
        
        let variance = protons.iter()
            .chain(electrons.iter())
            .map(|g| (g.magnitude - total_magnitude / (protons.len() + electrons.len()) as f64).powi(2))
            .sum::<f64>();
        
        // Stability = 1 / (1 + variance)
        // High variance = low stability
        1.0 / (1.0 + variance.sqrt())
    }
    
    const MAX_GRADIENT_MAGNITUDE: f64 = 1000.0; // From lib.flame entropy constraint
}
