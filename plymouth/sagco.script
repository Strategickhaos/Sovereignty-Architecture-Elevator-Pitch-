# SAGCO Plymouth Script
# Controls the boot splash animation and display
#
# This is a simplified example. Full Plymouth script would include
# animation sequences, progress bars, and message handling.

# Background
Window.SetBackgroundTopColor(0.04, 0.04, 0.04);
Window.SetBackgroundBottomColor(0.04, 0.04, 0.04);

# SAGCO Logo (placeholder - replace with actual image)
logo.image = Image("ratio_ex_nihilo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetHeight() / 3 - logo.image.GetHeight() / 2);

# Title text
title_text = "SAGCO BOOT IDENTITY PIPELINE v1.0";
title.image = Image.Text(title_text, 0.62, 0.31, 0.87);
title.sprite = Sprite(title.image);
title.sprite.SetX(Window.GetWidth() / 2 - title.image.GetWidth() / 2);
title.sprite.SetY(Window.GetHeight() / 2);

# Entity info
entity_text = "Strategickhaos DAO LLC | EIN: 39-2923503 | Wyoming: 2025-001708194";
entity.image = Image.Text(entity_text, 0.48, 0.17, 0.61);
entity.sprite = Sprite(entity.image);
entity.sprite.SetX(Window.GetWidth() / 2 - entity.image.GetWidth() / 2);
entity.sprite.SetY(Window.GetHeight() / 2 + 40);

# Motto
motto_text = "Ratio Ex Nihilo - From Nothing, Through Reason, Everything";
motto.image = Image.Text(motto_text, 0.35, 0.10, 0.60);
motto.sprite = Sprite(motto.image);
motto.sprite.SetX(Window.GetWidth() / 2 - motto.image.GetWidth() / 2);
motto.sprite.SetY(Window.GetHeight() / 2 + 80);

# Progress indicator
progress_box.image = Image("progress_box.png");
progress_box.sprite = Sprite(progress_box.image);
progress_box.sprite.SetX(Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2);
progress_box.sprite.SetY(Window.GetHeight() * 0.75);

progress_bar.original_image = Image("progress_bar.png");
progress_bar.sprite = Sprite();
progress_bar.sprite.SetX(Window.GetWidth() / 2 - progress_box.image.GetWidth() / 2);
progress_bar.sprite.SetY(Window.GetHeight() * 0.75);

# Progress callback
fun progress_callback(duration, progress) {
    if (progress_bar.original_image.GetWidth() > 0) {
        progress_bar.image = progress_bar.original_image.Scale(
            progress_bar.original_image.GetWidth() * progress,
            progress_bar.original_image.GetHeight()
        );
        progress_bar.sprite.SetImage(progress_bar.image);
    }
}

Plymouth.SetBootProgressFunction(progress_callback);

# Message handler
message_sprite = Sprite();
message_sprite.SetPosition(10, 10, 10000);

fun message_callback(text) {
    my_image = Image.Text(text, 0.62, 0.31, 0.87);
    message_sprite.SetImage(my_image);
    message_sprite.SetX(Window.GetWidth() / 2 - my_image.GetWidth() / 2);
    message_sprite.SetY(Window.GetHeight() * 0.9);
}

Plymouth.SetMessageFunction(message_callback);

# Display callback
fun display_normal_callback() {
    global.status = "normal";
}

fun display_password_callback(prompt, bullets) {
    global.status = "password";
}

fun display_question_callback(prompt, entry) {
    global.status = "question";
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
