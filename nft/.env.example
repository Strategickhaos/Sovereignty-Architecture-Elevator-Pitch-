# Environment variables for NFT deployment
# Copy this file to .env and fill in your values

# RPC URLs
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR-PROJECT-ID
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR-PROJECT-ID
POLYGON_RPC_URL=https://polygon-rpc.com
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com

# Deployer wallet private key (NEVER commit this to git!)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# API keys for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# Contract deployment addresses
ROYALTY_RECEIVER_ADDRESS=0x0000000000000000000000000000000000000000  # Multi-sig wallet
CREATOR_ADDRESS=0x0000000000000000000000000000000000000000        # Creator for Token #0
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000       # Treasury for other tokens

# IPFS configuration
IPFS_BASE_URI=ipfs://YOUR_BASE_CID/

# Deployed contract address (after deployment)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
