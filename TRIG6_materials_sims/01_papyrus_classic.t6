  },
  "process": {
    "steps": [
      "Harvest papyrus reeds 15-20cm from base (peak cellulose)",
      "Strip outer green rind, expose white pith",
      "Soak strips in water for 6-8 days",
      "Arrange in cross-layer (horizontal and vertical)",
      "Mallet to compress fibers and express cellular sap",
      "Press with stone blocks for 24-48 hours",
      "Sun dry under controlled heat",
      "Polish surface with shell or bone tool"
    ],
    "duration": "8-12 days",
    "difficulty": "moderate",
    "skill_level": "intermediate"
  },
