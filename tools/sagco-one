def main():
    """Main entry point"""
    if len(sys.argv) < 2 or sys.argv[1] in ['help', '-h', '--help']:
        show_help()
        sys.exit(0)
    
    command = sys.argv[1].lower()
    args = sys.argv[2:]
    
    if command == 'dna':
        print_banner()
        show_dna()
    elif command == 'status':
        print_banner()
        show_status()
    elif command == 'evolution':
        print_banner()
        show_evolution()
    elif command == 'mesh':
        sys.exit(run_command('mesh', args))
    elif command == 'oracle':
        sys.exit(run_command('oracle', args))
    elif command == 'benchmark':
        sys.exit(run_command('benchmark', args))
    elif command == 'full':
        print_banner()
        print("🚀 Running full deployment...")
        print()
        show_status()
        print()
        sys.exit(run_command('mesh', []))
    elif command == 'deploy':
        print("🚀 Deploy command placeholder - use sagco-deploy.py for actual deployment")
        sys.exit(1)
    else:
        print(f"❌ Unknown command: {command}")
        print("Run 'sagco-one help' for usage information")
        sys.exit(1)


if __name__ == "__main__":
    main()
