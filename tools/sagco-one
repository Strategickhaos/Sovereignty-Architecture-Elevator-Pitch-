def run_command(cmd: str, args: List[str]) -> int:
    """
    Run a SAGCO command
    
    Args:
        cmd: Command name
        args: Command arguments
    
    Returns:
        Exit code
    """
    # Find repository root
    script_dir = Path(__file__).parent
    repo_root = script_dir.parent
    tools_dir = repo_root / "tools"
    benchmarks_dir = repo_root / "benchmarks"
    
    # Map commands to executables
    command_map = {
        "mesh": tools_dir / "sagco-mesh",
        "oracle": tools_dir / "sagco-oracle",
        "benchmark": benchmarks_dir / "sagco-benchmark.py"
    }
    
    if cmd in command_map:
        cmd_path = command_map[cmd]
        if cmd_path.exists():
            try:
                # Run with Python if it's a .py file, otherwise run directly
                if cmd_path.suffix == ".py":
                    result = subprocess.run(["python3", str(cmd_path)] + args)
                else:
                    result = subprocess.run(["python3", str(cmd_path)] + args)
                return result.returncode
            except Exception as e:
                print(f"❌ Error running {cmd}: {e}")
                return 1
        else:
            print(f"❌ Command not found: {cmd_path}")
            return 1
    else:
        print(f"❌ Unknown command: {cmd}")
        return 1


