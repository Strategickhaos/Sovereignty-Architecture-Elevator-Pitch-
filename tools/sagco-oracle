    def analyze(self, text: str) -> Dict:
        """
        Run full ensemble analysis
        
        Args:
            text: Input text to analyze
        
        Returns:
            Combined analysis from all oracles
        """
        # Run all oracles
        signature_result = self.signature_oracle.analyze(text)
        entropy_result = self.entropy_oracle.analyze(text)
        network_result = self.network_oracle.analyze(text)
        search_space_result = self.search_space_oracle.analyze(text)
        
        # Calculate ensemble risk score (weighted average)
        ensemble_score = (
            signature_result['risk_score'] * 0.35 +  # Most important
            entropy_result['risk_score'] * 0.25 +
            network_result['risk_score'] * 0.25 +
            search_space_result['risk_score'] * 0.15
        )
        
        ensemble_score = round(ensemble_score, 2)
        
        return {
            "analysis_type": "OracleEnsemble",
            "dna_codon": "ORB1",
            "version": "1.0.0",
            "timestamp": datetime.utcnow().isoformat() + "Z",
            "text_length": len(text),
            "ensemble_risk_score": ensemble_score,
            "ensemble_risk_level": self._risk_level(ensemble_score),
            "oracles": {
                "signature": signature_result,
                "entropy": entropy_result,
                "network": network_result,
                "search_space": search_space_result
            },
            "recommendation": self._get_recommendation(ensemble_score)
        }
    
    def _risk_level(self, score: float) -> str:
        """Convert risk score to level"""
        if score >= 75:
            return "CRITICAL"
        elif score >= 50:
            return "HIGH"
        elif score >= 25:
            return "MEDIUM"
        elif score > 0:
            return "LOW"
        else:
            return "SAFE"
    
    def _get_recommendation(self, score: float) -> str:
        """Get recommendation based on score"""
        if score >= 75:
            return "REJECT: High confidence hallucination detected"
        elif score >= 50:
            return "WARN: Significant hallucination indicators present"
        elif score >= 25:
            return "REVIEW: Some suspicious patterns detected"
        elif score > 0:
            return "CAUTION: Minor concerns, verify independently"
        else:
            return "ACCEPT: No significant hallucination indicators"


