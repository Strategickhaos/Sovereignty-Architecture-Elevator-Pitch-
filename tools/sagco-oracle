        print(f"📊 ENSEMBLE ANALYSIS")
        print(f"   Risk Score: {result['ensemble_risk_score']:.2f}/100")
        print(f"   Risk Level: {result['ensemble_risk_level']}")
        print(f"   Recommendation: {result['recommendation']}")
