class SignatureOracle:
    """Pattern-based signature detection using Yara-style rules"""
    
    # Risk scoring constants
    RISK_SCORE_PER_MATCH = 0.15
    
    HALLUCINATION_PATTERNS = [
        r'\b(definitely|absolutely|certainly|always|never)\s+(true|false|correct|wrong)\b',
        r'\bI\s+(am|was)\s+(trained|created|designed)\s+by\b',
        r'\b(in|on)\s+\d{4}-\d{2}-\d{2}\b',  # Specific dates
        r'\b(exactly|precisely)\s+\d+(\.\d+)?%\b',  # Exact percentages
        r'\baccording to (my|the)\s+(training|database|knowledge)\b',
        r'\b(guaranteed|promise|swear)\s+to\b',
        r'\ball\s+\w+\s+(are|must|should|will)\b',  # Absolute statements
    ]
    
    def analyze(self, text: str) -> Dict:
        """Analyze text for hallucination signature patterns"""
        matches = []
        for pattern in self.HALLUCINATION_PATTERNS:
            found = re.finditer(pattern, text, re.IGNORECASE)
            matches.extend([(m.group(), m.start(), m.end()) for m in found])
        
        risk_score = min(len(matches) * self.RISK_SCORE_PER_MATCH, 1.0)
        
        return {
            "oracle": "SignatureOracle",
            "patterns_matched": len(matches),
            "matches": [{"text": m[0], "pos": [m[1], m[2]]} for m in matches[:10]],
            "risk_score": round(risk_score, 3),
            "status": "ALERT" if risk_score > 0.5 else "WARNING" if risk_score > 0.2 else "CLEAR"
        }

class NetworkOracle:
    """Network-style analysis for information flow patterns"""
    
    def analyze(self, text: str) -> Dict:
        """Analyze information flow and citation patterns"""
        words = text.split()
        sentences = [s.strip() for s in re.split(r'[.!?]+', text) if s.strip()]
        
        # Check for citation patterns
        has_citations = bool(re.search(r'\[([\d,\s]+)\]|\(\d{4}\)', text))
        has_hedging = bool(re.search(r'\b(may|might|could|possibly|perhaps|likely)\b', text, re.IGNORECASE))
        has_sources = bool(re.search(r'\b(source|study|research|according to)\b', text, re.IGNORECASE))
        
        # Calculate citation density
        citation_count = len(re.findall(r'\[([\d,\s]+)\]|\(\d{4}\)', text))
        citation_density = citation_count / max(len(sentences), 1)
        
        # Risk increases with lack of citations and hedging
        risk_score = 0.0
        if not has_citations:
            risk_score += 0.3
        if not has_hedging:
            risk_score += 0.2
        if not has_sources:
            risk_score += 0.2
        if citation_density < 0.1:
            risk_score += 0.3
        
        risk_score = min(risk_score, 1.0)
        
        return {
            "oracle": "NetworkOracle",
            "has_citations": has_citations,
            "has_hedging": has_hedging,
            "has_sources": has_sources,
            "citation_density": round(citation_density, 3),
            "risk_score": round(risk_score, 3),
            "status": "ALERT" if risk_score > 0.6 else "WARNING" if risk_score > 0.3 else "CLEAR"
        }

class SearchSpaceOracle:
    """Search space analysis for contradiction and consistency"""
    
    def analyze(self, text: str) -> Dict:
        """Analyze for internal contradictions and consistency"""
        sentences = [s.strip() for s in re.split(r'[.!?]+', text) if s.strip()]
        
        # Look for contradictory statements
        negation_patterns = [
            (r'\b(is|are|was|were)\b', r'\b(is not|are not|was not|were not|isn\'t|aren\'t|wasn\'t|weren\'t)\b'),
            (r'\b(can|could|will|would)\b', r'\b(cannot|could not|will not|would not|can\'t|couldn\'t|won\'t|wouldn\'t)\b'),
            (r'\ball\b', r'\b(some|few|none)\b'),
            (r'\balways\b', r'\b(sometimes|never|rarely)\b'),
        ]
        
        contradictions = 0
        for pos_pattern, neg_pattern in negation_patterns:
            has_positive = bool(re.search(pos_pattern, text, re.IGNORECASE))
            has_negative = bool(re.search(neg_pattern, text, re.IGNORECASE))
            if has_positive and has_negative:
                contradictions += 1
        
        # Check for qualifier inconsistency
        qualifiers = ['all', 'some', 'most', 'many', 'few', 'none']
        qualifier_count = sum(1 for q in qualifiers if re.search(rf'\b{q}\b', text, re.IGNORECASE))
        
        risk_score = min((contradictions * 0.3) + (qualifier_count * 0.05), 1.0)
        
        return {
            "oracle": "SearchSpaceOracle",
            "contradictions_found": contradictions,
            "qualifier_diversity": qualifier_count,
            "risk_score": round(risk_score, 3),
            "status": "ALERT" if risk_score > 0.5 else "WARNING" if risk_score > 0.3 else "CLEAR"
        }

class EntropyOracle:
    """Shannon entropy and randomness analysis"""
    
    # Threshold constants
    LOW_ENTROPY_THRESHOLD = 0.7
    LOW_DIVERSITY_THRESHOLD = 0.4
    
    def calculate_entropy(self, text: str) -> float:
        """Calculate Shannon entropy of text"""
        if not text:
            return 0.0
        
        # Count character frequencies
        counter = Counter(text.lower())
        total = len(text)
        
        # Calculate Shannon entropy
        entropy = 0.0
        for count in counter.values():
            probability = count / total
            entropy -= probability * math.log2(probability)
        
        return entropy
    
    def analyze(self, text: str) -> Dict:
        """Analyze entropy and linguistic diversity"""
        words = text.split()
        word_count = len(words)
        unique_words = len(set(word.lower() for word in words))
        
        # Calculate metrics
        entropy = self.calculate_entropy(text)
        lexical_diversity = unique_words / max(word_count, 1)
        
        # Normalize entropy (typical English text: 4.0-4.5 bits/char)
        normalized_entropy = entropy / 4.5
        
        # Low entropy or low diversity suggests templated/generated text
        risk_score = 0.0
        if normalized_entropy < self.LOW_ENTROPY_THRESHOLD:
            risk_score += 0.4
        if lexical_diversity < self.LOW_DIVERSITY_THRESHOLD:
            risk_score += 0.4
        
        risk_score = min(risk_score, 1.0)
        
        return {
            "oracle": "EntropyOracle",
            "shannon_entropy": round(entropy, 3),
            "normalized_entropy": round(normalized_entropy, 3),
            "lexical_diversity": round(lexical_diversity, 3),
            "word_count": word_count,
            "unique_words": unique_words,
            "risk_score": round(risk_score, 3),
            "status": "ALERT" if risk_score > 0.6 else "WARNING" if risk_score > 0.4 else "CLEAR"
        }

