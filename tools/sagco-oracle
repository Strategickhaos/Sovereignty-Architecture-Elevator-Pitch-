def main():
    """Main entry point"""
    if len(sys.argv) < 2 or '--help' in sys.argv or '-h' in sys.argv:
        show_help()
        sys.exit(0)
    
    # Parse arguments
    text = None
    output_json = False
    
    i = 1
    while i < len(sys.argv):
        arg = sys.argv[i]
        
        if arg in ['-f', '--file']:
            if i + 1 >= len(sys.argv):
                print("❌ Error: -f/--file requires a filename")
                sys.exit(1)
            
            filename = sys.argv[i + 1]
            try:
                with open(filename, 'r', encoding='utf-8') as f:
                    text = f.read()
            except Exception as e:
                print(f"❌ Error reading file: {e}")
                sys.exit(1)
            i += 2
        elif arg in ['-j', '--json']:
            output_json = True
            i += 1
        else:
            # Treat as text input
            text = ' '.join(sys.argv[i:])
            break
    
    if not text:
        print("❌ Error: No text provided for analysis")
        sys.exit(1)
    
    # Run analysis
    ensemble = OracleEnsemble()
    result = ensemble.analyze(text)
    
    if output_json:
        print(json.dumps(result, indent=2))
    else:
