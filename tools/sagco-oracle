class SignatureOracle:
    """Pattern-based hallucination detection using signature matching"""
    
    def __init__(self):
        self.patterns = HALLUCINATION_PATTERNS
    
    def analyze(self, text: str) -> Dict:
        """
        Analyze text for hallucination signatures
        
        Args:
            text: Input text to analyze
        
        Returns:
            Analysis results with detected patterns
        """
        text_lower = text.lower()
        detected = {}
        total_matches = 0
        
        for category, patterns in self.patterns.items():
            matches = []
            for pattern in patterns:
                found = re.finditer(pattern, text_lower, re.IGNORECASE)
                for match in found:
                    matches.append({
                        "pattern": pattern,
                        "text": match.group(0),
                        "position": match.span()
                    })
            
            if matches:
                detected[category] = matches
                total_matches += len(matches)
        
        risk_score = min(100, total_matches * 15)  # 15 points per match, max 100
        
        return {
            "oracle": "SignatureOracle",
            "risk_score": risk_score,
            "risk_level": self._risk_level(risk_score),
            "matches": total_matches,
            "detected_patterns": detected,
            "timestamp": datetime.utcnow().isoformat() + "Z"
        }
    
    def _risk_level(self, score: int) -> str:
        """Convert risk score to level"""
        if score >= 75:
            return "CRITICAL"
        elif score >= 50:
            return "HIGH"
        elif score >= 25:
            return "MEDIUM"
        elif score > 0:
            return "LOW"
        else:
            return "SAFE"


class EntropyOracle:
    """Information theory-based analysis using Shannon entropy"""
    
    def analyze(self, text: str) -> Dict:
        """
        Calculate Shannon entropy of text
        
        Args:
            text: Input text to analyze
        
        Returns:
            Entropy analysis results
        """
        if not text:
            return {
                "oracle": "EntropyOracle",
                "entropy": 0.0,
                "risk_score": 100,
                "risk_level": "CRITICAL",
                "classification": "empty"
            }
        
        # Calculate character-level entropy
        char_counts = Counter(text)
        text_length = len(text)
        
        entropy = 0.0
        for count in char_counts.values():
            probability = count / text_length
            entropy -= probability * math.log2(probability)
        
        # Calculate word-level entropy for comparison
        words = text.lower().split()
        word_counts = Counter(words)
        word_entropy = 0.0
        
        if words:
            total_words = len(words)
            for count in word_counts.values():
                probability = count / total_words
                word_entropy -= probability * math.log2(probability)
        
        # Classify entropy
        classification = self._classify_entropy(entropy)
        
        # Calculate risk score (very low or very high entropy is suspicious)
        if entropy < ENTROPY_THRESHOLDS["low"]:
            risk_score = int((ENTROPY_THRESHOLDS["low"] - entropy) * 30)
        elif entropy > ENTROPY_THRESHOLDS["high"]:
            risk_score = int((entropy - ENTROPY_THRESHOLDS["high"]) * 20)
        else:
            risk_score = 0
        
        risk_score = min(100, risk_score)
        
        return {
            "oracle": "EntropyOracle",
            "entropy": round(entropy, 4),
            "word_entropy": round(word_entropy, 4),
            "risk_score": risk_score,
            "risk_level": self._risk_level(risk_score),
            "classification": classification,
            "timestamp": datetime.utcnow().isoformat() + "Z"
        }
    
    def _classify_entropy(self, entropy: float) -> str:
        """Classify entropy value"""
        if entropy < ENTROPY_THRESHOLDS["very_low"]:
            return "very_low_entropy"
        elif entropy < ENTROPY_THRESHOLDS["low"]:
            return "low_entropy"
        elif entropy < ENTROPY_THRESHOLDS["normal"]:
            return "normal_entropy"
        elif entropy < ENTROPY_THRESHOLDS["high"]:
            return "high_entropy"
        elif entropy < ENTROPY_THRESHOLDS["very_high"]:
            return "very_high_entropy"
        else:
            return "extreme_entropy"
    
    def _risk_level(self, score: int) -> str:
        """Convert risk score to level"""
        if score >= 75:
            return "CRITICAL"
        elif score >= 50:
            return "HIGH"
        elif score >= 25:
            return "MEDIUM"
        elif score > 0:
            return "LOW"
        else:
            return "SAFE"


class NetworkOracle:
    """Behavioral analysis based on network patterns"""
    
    def analyze(self, text: str) -> Dict:
        """
        Analyze text for behavioral patterns
        
        Args:
            text: Input text to analyze
        
        Returns:
            Network analysis results
        """
        indicators = {}
        risk_factors = 0
        
        # Check for repetitive structures
        sentences = text.split('.')
        if len(sentences) > 3:
            sentence_lengths = [len(s.strip()) for s in sentences if s.strip()]
            if sentence_lengths:
                avg_length = sum(sentence_lengths) / len(sentence_lengths)
                variance = sum((l - avg_length) ** 2 for l in sentence_lengths) / len(sentence_lengths)
                
                if variance < 50:  # Very uniform sentence length
                    indicators["uniform_structure"] = True
                    risk_factors += 1
        
        # Check for excessive capitalization
        if text.isupper():
            indicators["all_caps"] = True
            risk_factors += 2
        
        # Check for URL patterns (potential link injection)
        url_pattern = r'https?://[^\s]+'
        urls = re.findall(url_pattern, text)
        if len(urls) > 5:
            indicators["excessive_urls"] = True
            risk_factors += 1
        
        # Check for number density (potential data fabrication)
        numbers = re.findall(r'\d+\.?\d*', text)
        if len(text) > 0:
            number_density = len(numbers) / len(text.split())
            if number_density > 0.3:
                indicators["high_number_density"] = True
                risk_factors += 1
        
        risk_score = min(100, risk_factors * 20)
        
        return {
            "oracle": "NetworkOracle",
            "risk_score": risk_score,
            "risk_level": self._risk_level(risk_score),
            "indicators": indicators,
            "risk_factors": risk_factors,
            "timestamp": datetime.utcnow().isoformat() + "Z"
        }
    
    def _risk_level(self, score: int) -> str:
        """Convert risk score to level"""
        if score >= 75:
            return "CRITICAL"
        elif score >= 50:
            return "HIGH"
        elif score >= 25:
            return "MEDIUM"
        elif score > 0:
            return "LOW"
        else:
            return "SAFE"


class SearchSpaceOracle:
    """Cryptographic-style analysis of text complexity"""
    
    def analyze(self, text: str) -> Dict:
        """
        Analyze text search space and complexity
        
        Args:
            text: Input text to analyze
        
        Returns:
            Search space analysis results
        """
        if not text:
            return {
                "oracle": "SearchSpaceOracle",
                "complexity": 0,
                "risk_score": 100,
                "risk_level": "CRITICAL"
            }
        
        # Calculate character set size
        unique_chars = len(set(text))
        
        # Calculate unique word count
        words = text.lower().split()
        unique_words = len(set(words))
        total_words = len(words)
        
        # Vocabulary richness ratio
        vocab_richness = unique_words / total_words if total_words > 0 else 0
        
        # Calculate approximate search space (combinatorial)
        search_space_log = math.log2(unique_chars) * len(text) if unique_chars > 0 else 0
        
        # Low vocabulary richness suggests templated/repetitive content
        if vocab_richness < 0.3:
            risk_score = int((0.3 - vocab_richness) * 200)
        elif vocab_richness > 0.95:
            # Unusually high richness (every word unique) is also suspicious
            risk_score = int((vocab_richness - 0.95) * 200)
        else:
            risk_score = 0
        
        risk_score = min(100, risk_score)
        
        return {
            "oracle": "SearchSpaceOracle",
            "unique_chars": unique_chars,
            "unique_words": unique_words,
            "total_words": total_words,
            "vocab_richness": round(vocab_richness, 4),
            "search_space_log2": round(search_space_log, 2),
            "risk_score": risk_score,
            "risk_level": self._risk_level(risk_score),
            "timestamp": datetime.utcnow().isoformat() + "Z"
        }
    
    def _risk_level(self, score: int) -> str:
        """Convert risk score to level"""
        if score >= 75:
            return "CRITICAL"
        elif score >= 50:
            return "HIGH"
        elif score >= 25:
            return "MEDIUM"
        elif score > 0:
            return "LOW"
        else:
            return "SAFE"


class OracleEnsemble:
    """Ensemble of all four oracles for comprehensive analysis"""
    
    def __init__(self):
        self.signature_oracle = SignatureOracle()
        self.entropy_oracle = EntropyOracle()
        self.network_oracle = NetworkOracle()
