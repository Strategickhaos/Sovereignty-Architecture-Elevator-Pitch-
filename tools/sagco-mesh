def check_node_reachable(ip: str, port: int = 22, timeout: float = 2.0) -> bool:
    """Check if a node is reachable via TCP connection"""
    if 'x.x' in ip:  # Skip unconfigured IPs
        return False
    
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        result = sock.connect_ex((ip, port))
        sock.close()
        return result == 0
    except (socket.gaierror, socket.timeout, OSError):
        return False

def ping_node(ip: str) -> bool:
    """Ping a node to check basic network connectivity"""
    if 'x.x' in ip:  # Skip unconfigured IPs
        return False
    
    try:
        # Use ping with 1 second timeout, 1 packet
        result = subprocess.run(
            ['ping', '-c', '1', '-W', '1', ip],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2
        )
        return result.returncode == 0
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return False

