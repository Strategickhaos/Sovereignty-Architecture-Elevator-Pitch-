def check_node_connectivity(ip: str, port: int = 22, timeout: float = 1.0) -> bool:
    """
    Check if a node is reachable on the network
    
    Args:
        ip: IP address to check
        port: Port to check (default: 22 for SSH)
        timeout: Connection timeout in seconds
    
    Returns:
        True if node is reachable, False otherwise
    """
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        result = sock.connect_ex((ip, port))
        sock.close()
        return result == 0
    except (socket.error, socket.timeout):
        return False


def ping_node(ip: str) -> bool:
    """
    Ping a node to check basic connectivity
    
    Args:
        ip: IP address to ping
    
    Returns:
        True if ping successful, False otherwise
    """
    try:
        # Use platform-appropriate ping command
        if sys.platform == "win32":
            result = subprocess.run(
                ["ping", "-n", "1", "-w", "1000", ip],
                capture_output=True,
                timeout=2
            )
        else:
            result = subprocess.run(
                ["ping", "-c", "1", "-W", "1", ip],
                capture_output=True,
                timeout=2
            )
        return result.returncode == 0
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return False


def discover_nodes() -> Dict[str, Dict]:
    """
    Discover all neural mesh nodes
    
    Returns:
        Dictionary of node statuses
    """
    print("🔍 Discovering STRATEGICKHAOS Neural Mesh nodes...")
    print()
    
    discovered = {}
    
    for node_id, node_info in MESH_NODES.items():
        print(f"📡 Scanning {node_info['name']} ({node_info['role']})...")
        
        ip = node_info['ip_primary']
        status = {
            "name": node_info['name'],
            "role": node_info['role'],
            "specs": node_info['specs'],
            "ip": ip,
            "reachable": False,
            "ping": False,
            "open_ports": [],
            "timestamp": datetime.utcnow().isoformat() + "Z"
        }
        
        # Check ping
        if ping_node(ip):
            status['ping'] = True
            print(f"  ✅ PING: {ip} responds")
        else:
            print(f"  ❌ PING: {ip} unreachable")
            
            # Try fallback IPs
            for fallback_ip in node_info.get('ip_fallback', []):
                if ping_node(fallback_ip):
                    status['ping'] = True
                    status['ip'] = fallback_ip
                    print(f"  ✅ PING: Fallback {fallback_ip} responds")
                    ip = fallback_ip
                    break
        
        # Check ports
        for port in node_info['ports']:
            if check_node_connectivity(ip, port):
                status['open_ports'].append(port)
                status['reachable'] = True
        
        if status['open_ports']:
            print(f"  ✅ PORTS: {', '.join(map(str, status['open_ports']))} open")
        else:
            print(f"  ⚠️  PORTS: No open ports detected")
        
        discovered[node_id] = status
        print()
    
    return discovered


