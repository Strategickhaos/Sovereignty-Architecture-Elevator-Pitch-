    parser = argparse.ArgumentParser(
        description='SAGCO-MESH - Neural Mesh Node Discovery & Status',
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        'action',
        nargs='?',
        default='status',
        choices=['status', 'discover', 'sync', 'help'],
        help='Action to perform (default: status)'
    )
    parser.add_argument(
        '-v', '--verbose',
        action='store_true',
        help='Show detailed node specifications'
    )
    parser.add_argument(
        '-o', '--output',
        help='Save results to JSON file'
    )
    
    args = parser.parse_args()
    
    if args.action == 'help':
        parser.print_help()
        return 0
    
    # Perform mesh discovery
    results = discover_mesh(verbose=args.verbose)
    
    # Save to file if requested
    if args.output:
        save_mesh_state(results, args.output)
    
    # Exit code based on mesh health
    if results['nodes_online'] == 0:
        print("❌ CRITICAL: No mesh nodes online!")
        return 2
    elif results['nodes_online'] < results['total_nodes']:
        print(f"⚠️  WARNING: Only {results['nodes_online']}/{results['total_nodes']} nodes online")
        return 1
    else:
        print("✅ SUCCESS: All mesh nodes online!")
        return 0

if __name__ == '__main__':
    sys.exit(main())
