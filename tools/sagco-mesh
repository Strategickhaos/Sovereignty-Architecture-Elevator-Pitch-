def save_mesh_state(results: Dict, filename: str = "mesh_state.json"):
    """Save mesh discovery results to JSON file"""
    with open(filename, 'w') as f:
        json.dump(results, f, indent=2)
    print(f"💾 Mesh state saved to: {filename}")

def main():
