def display_node_status():
    """Display status of all mesh nodes"""
    print("Node Discovery & Status:")
    print("─" * 80)
    
    for node, info in MESH_NODES.items():
        role = info.get('role', 'Unknown')
        ip = info.get('ip', 'N/A')
        
        # Check reachability
        status = "❓"
        status_text = "Unknown"
        
        if 'ip' in info and '/' not in info['ip']:
            reachable = check_node_reachable(info['ip'])
            if reachable is True:
                status = "✅"
                status_text = "Online"
            elif reachable is False:
                status = "❌"
                status_text = "Offline"
        
        # Build info string
        info_parts = []
        if 'cpu' in info:
            info_parts.append(f"CPU: {info['cpu']}")
        if 'ram' in info:
            info_parts.append(f"RAM: {info['ram']}")
        if 'device' in info:
            info_parts.append(f"Device: {info['device']}")
        
        info_str = " | ".join(info_parts) if info_parts else "Virtual node"
        
        print(f"{status} {node.upper():10} | {role:18} | {ip:20} | {status_text:8}")
        if info_str:
            print(f"   └─ {info_str}")
    
    print("─" * 80)
    print()

