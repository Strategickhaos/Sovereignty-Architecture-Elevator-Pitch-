def show_status():
    """Show brief status of all nodes"""
    nodes = ['athena', 'lyra', 'nova', 'ateroth', 'sagco-vm']
    
    print("=" * 70)
    print("MESH NODE STATUS")
    print("=" * 70)
    
    for node_name in nodes:
        config = load_node_config(node_name)
        if config:
            node_id = config.get('node_id', 'unknown')
            status = config.get('status', 'unknown')
            role = config.get('role', 'unknown')
            ip = config.get('network', {}).get('primary_ip', 'unknown')
            
            status_emoji = "✅" if status == "active" else "❌"
            print(f"{status_emoji} {node_id.upper():12} | {role:18} | {ip}")
        else:
            print(f"⚠️  {node_name.upper():12} | NOT CONFIGURED")
    
    print("=" * 70)


def main():
    if len(sys.argv) > 1:
        arg = sys.argv[1].lower()
        
        if arg in ("--status", "-s"):
            show_status()
        elif arg in ("--topology", "-t"):
            show_topology()
        elif arg in ("--detailed", "-d"):
            show_all_nodes(detailed=True)
        elif arg in ("--help", "-h"):
            print(__doc__)
        else:
            print(f"Unknown option: {arg}")
            print("Use --help for usage information")
            sys.exit(1)
    else:
        show_all_nodes(detailed=False)


if __name__ == "__main__":
    main()
