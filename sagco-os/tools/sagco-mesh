#!/usr/bin/env python3
"""
SAGCO-MESH - Neural Mesh Node Discovery
Version: 1.0.0
Part of CMD27 Arsenal

Discovers and displays all 5 nodes in the SAGCO neural mesh:
- Athena (Subconscious) 
- Lyra (Right Hemisphere)
- Nova (Left Hemisphere)
- Ateroth (Archive)
- SAGCO-VM (Soul)

Usage:
    sagco-mesh              # Show all nodes
    sagco-mesh --status     # Show node status
    sagco-mesh --topology   # Show network topology
"""

import sys
import yaml
from pathlib import Path
from typing import List, Dict, Any


def load_node_config(node_name: str) -> Dict[str, Any]:
    """Load node configuration from YAML"""
    config_dir = Path(__file__).parent.parent / "mesh" / "hosts"
    config_file = config_dir / f"{node_name}.yaml"
    
    if not config_file.exists():
        return None
    
    with open(config_file, 'r') as f:
        return yaml.safe_load(f)


def show_node(config: Dict[str, Any], detailed: bool = False):
    """Display node information"""
    node_id = config.get('node_id', 'unknown')
    role = config.get('role', 'unknown')
    status = config.get('status', 'unknown')
    
    hw = config.get('hardware', {})
    net = config.get('network', {})
    
    # Status emoji
    status_emoji = "✅" if status == "active" else "❌"
    
    print(f"\n{'='*70}")
    print(f"{status_emoji} {node_id.upper()} - {role.replace('_', ' ').title()}")
    print(f"{'='*70}")
    print(f"Status:     {status}")
    print(f"IP:         {net.get('primary_ip', 'unknown')}")
    print(f"Hostname:   {net.get('hostname', 'unknown')}")
    
    if detailed:
        print(f"\nHardware:")
        print(f"  CPU:      {hw.get('cpu', 'unknown')}")
        print(f"  Cores:    {hw.get('cores', 'N/A')}")
        print(f"  RAM:      {hw.get('ram_gb', 'N/A')} GB")
        print(f"  Storage:  {hw.get('storage', 'unknown')}")
        
        if 'gpu' in hw and hw['gpu'] != 'None' and hw['gpu'] != 'Integrated':
            print(f"  GPU:      {hw['gpu']}")
        
        print(f"\nCapabilities:")
        for cap in config.get('capabilities', []):
            print(f"  • {cap.replace('_', ' ')}")
        
        print(f"\nServices:")
        for svc in config.get('services', []):
            svc_status = svc.get('status', 'unknown')
            svc_emoji = "🟢" if svc_status == "running" else "🔴"
            print(f"  {svc_emoji} {svc['name']}:{svc.get('port', 'N/A')}")


def show_all_nodes(detailed: bool = False):
    """Show all mesh nodes"""
    nodes = ['athena', 'lyra', 'nova', 'ateroth', 'sagco-vm']
    
    print("=" * 70)
    print("SAGCO NEURAL MESH (MESH5) - 5-NODE DISTRIBUTED NETWORK")
    print("=" * 70)
    print("DNA Codon: MESH5 v5.0")
    print("Status: 🔜 BUILDING")
    
    active_count = 0
    
    for node_name in nodes:
        config = load_node_config(node_name)
        if config:
            if config.get('status') == 'active':
                active_count += 1
            show_node(config, detailed)
        else:
            print(f"\n⚠️  {node_name.upper()} - Configuration not found")
    
    print("\n" + "=" * 70)
    print(f"MESH SUMMARY: {active_count}/{len(nodes)} nodes active")
    print("=" * 70)


