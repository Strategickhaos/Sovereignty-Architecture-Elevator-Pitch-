def print_header():
    """Print benchmark header"""
    print("╔" + "═" * 78 + "╗")
    print("║" + " " * 15 + "SAGCO-BEN MULTI-LANGUAGE EFFICIENCY BENCHMARK v1.0.0" + " " * 10 + "║")
    print("╚" + "═" * 78 + "╝")
    print()


def print_toolchain_status(results: List[BenchmarkResult]):
    """Print toolchain availability"""
    print("Toolchain Status:")
    for result in results:
        if result.available:
            print(f"  ✅ {result.language}")
        else:
            print(f"  ❌ {result.language} ({result.error})")
    print()


def print_results(results: List[BenchmarkResult]):
    """Print benchmark results"""
    for result in results:
        if result.available and result.time_ms is not None:
            print(f"▶️  Running {result.language.capitalize()} benchmark...")
            print(f"    ⏱️  {result.time_ms:,.2f}ms | 📊 {result.ops_per_sec:,} ops/sec")
            print()


def generate_recommendations(results: List[BenchmarkResult]):
    """Generate DNA mutation recommendations"""
    print("🔧 EVOLUTION RECOMMENDATIONS:")
    
    # Check FlameLang
    flamelang_result = next((r for r in results if r.language == "flamelang"), None)
    if flamelang_result and not flamelang_result.available:
        print("🔴 [FLM2_COMPILER] Efficiency: 0% → 100%")
        print("   FlameLang compiler not installed. Build with: cargo build --release")
        print()
    
    # Check overall performance
    available_results = [r for r in results if r.available and r.efficiency]
    if available_results:
        avg_efficiency = sum(r.efficiency for r in available_results) / len(available_results)
        
        if avg_efficiency < 50:
            print("⚠️  [PERFORMANCE] Average efficiency below 50%")
            print("   Consider optimizing hot paths or upgrading hardware")
            print()
    
    print("🧬 SUGGESTED DNA MUTATIONS:")
    print("  Current: SAGCO-ATG-FLM2-MSMC2-P16-CMD27-ISO103-MESH5-ORB1")
    
    # Generate mutation based on results
    if flamelang_result and flamelang_result.available:
        print("  Next:    SAGCO-ATG-FLM2.1-MSMC2-P16-CMD27-ISO103-MESH5-ORB1")
        print("           (FlameLang native execution enabled)")
    else:
        print("  Next:    SAGCO-ATG-FLM2-MSMC2-P16-CMD27-ISO104-MESH5-ORB1")
        print("           (ISO upgrade for better performance)")


def run_benchmarks(quick: bool = False, specific_lang: Optional[str] = None):
    """Run all benchmarks"""
    print_header()
    
    iterations_map = {
        "python": 100000 if quick else 1000000,
        "rust": 100000 if quick else 1000000,
        "bash": 1000 if quick else 10000,
        "csharp": 100000 if quick else 1000000,
    }
    
    results = []
    
    # Run benchmarks
    if not specific_lang or specific_lang == "python":
        results.append(benchmark_python(iterations_map["python"]))
    
    if not specific_lang or specific_lang == "rust":
        results.append(benchmark_rust(iterations_map["rust"]))
    
    if not specific_lang or specific_lang == "bash":
        results.append(benchmark_bash(iterations_map["bash"]))
    
    if not specific_lang or specific_lang == "csharp":
        results.append(benchmark_csharp(iterations_map["csharp"]))
    
    if not specific_lang or specific_lang == "flamelang":
        results.append(benchmark_flamelang())
    
    # Print results
    print_toolchain_status(results)
    print_results(results)
    generate_recommendations(results)


def main():
    quick = "--quick" in sys.argv
    specific_lang = None
    
    if "--lang" in sys.argv:
        try:
            idx = sys.argv.index("--lang")
            specific_lang = sys.argv[idx + 1].lower()
        except (IndexError, ValueError):
            print("Error: --lang requires a language argument")
            sys.exit(1)
    
    if "--help" in sys.argv or "-h" in sys.argv:
        print(__doc__)
        sys.exit(0)
    
    run_benchmarks(quick=quick, specific_lang=specific_lang)


if __name__ == "__main__":
    main()
