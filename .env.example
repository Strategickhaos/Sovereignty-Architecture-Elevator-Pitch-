# Sovereign Cognitive Architecture - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# REQUIRED: LLM API KEYS
# ============================================================================

# Anthropic Claude API Key
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI GPT API Key
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ============================================================================
# OPTIONAL: Additional LLM Providers
# ============================================================================

# Alibaba Qwen/DashScope API Key (for Chinese language support)
# Get yours at: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# Custom LLM Configuration (for self-hosted or alternative providers)
CUSTOM_API_KEY=your-custom-api-key
CUSTOM_BASE_URL=http://localhost:8004

# ============================================================================
# DISCORD CONFIGURATION (for DevOps integration)
# ============================================================================

# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=your_server_id_here

# Discord Channel IDs (enable Developer Mode in Discord to get these)
PRS_CHANNEL=1234567890123456789
DEV_FEED_CHANNEL=1234567890123456789
DEPLOYMENTS_CHANNEL=1234567890123456789
CLUSTER_STATUS_CHANNEL=1234567890123456789
ALERTS_CHANNEL=1234567890123456789
AGENTS_CHANNEL=1234567890123456789

# ============================================================================
# GITHUB INTEGRATION
# ============================================================================

GITHUB_ORG=your-github-org
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ============================================================================
# CRYPTOGRAPHIC SIGNING
# ============================================================================

# GPG Key ID for signing exports (optional but recommended)
# Generate with: gpg --gen-key
# Find your key ID: gpg --list-keys
GPG_KEY_ID=ABCD1234EFGH5678

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Grafana admin password (default: admin)
GRAFANA_PASSWORD=your-secure-password-here

# Prometheus retention period (default: 15d)
PROMETHEUS_RETENTION=15d

# ============================================================================
# MEMORY MESH CONFIGURATION
# ============================================================================

# Embedding model for vector search (default: BAAI/bge-small-en-v1.5)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Qdrant URL (default: http://qdrant:6333)
QDRANT_URL=http://localhost:6333

# Redis URL (default: redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Log level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Enable audit logging (true | false)
ENABLE_AUDIT=true

# ============================================================================
# GITLENS CONFIGURATION
# ============================================================================

GITLENS_EDITION=pro
VSCODE_USERS_GROUP=devs

# ============================================================================
# EVENT GATEWAY
# ============================================================================

EVENT_GATEWAY_URL=https://events.yourco.com
HMAC_SECRET=your_hmac_secret

# ============================================================================
# ENVIRONMENT
# ============================================================================

NODE_ENV=development
DEBUG=false

# ============================================================================
# METADATA
# ============================================================================

