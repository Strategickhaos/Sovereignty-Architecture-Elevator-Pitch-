[Unit]
Description=SAGCO CPU Bytecode Interpreter/VM
Documentation=https://github.com/Strategickhaos/Sovereignty-Architecture-Elevator-Pitch-
After=sagco-compiler.service
Requires=sagco-compiler.service

[Service]
Type=simple
ExecStart=/opt/sagco/sagco-cpu-vm --load-bytecode /opt/sagco/artifacts/
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sagco

[Install]
WantedBy=multi-user.target
