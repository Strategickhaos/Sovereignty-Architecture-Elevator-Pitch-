[Unit]
Description=SAGCO Compiler (FlameLang)
Documentation=https://github.com/Strategickhaos/Sovereignty-Architecture-Elevator-Pitch-
After=sagco-runtime.service
Requires=sagco-runtime.service

[Service]
Type=simple
ExecStart=/opt/sagco/flamelang-compiler --daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sagco

[Install]
WantedBy=multi-user.target
