[Unit]
Description=SAGCO Runtime
Documentation=https://github.com/Strategickhaos/Sovereignty-Architecture-Elevator-Pitch-
After=network.target sagco-banner.service
Wants=sagco-banner.service

[Service]
Type=simple
ExecStart=/opt/sagco/runtime.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sagco

[Install]
WantedBy=multi-user.target
