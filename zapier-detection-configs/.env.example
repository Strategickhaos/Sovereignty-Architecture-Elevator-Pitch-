# ============================================================
# STRATEGICKHAOS 36-LAYER DETECTION MATRIX
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env in your Zapier environment
# 2. Fill in all required values
# 3. Never commit .env to version control
# 4. Rotate credentials regularly
#
# ============================================================

# ============================================================
# WEBHOOK ENDPOINTS
# ============================================================

# Discord Webhooks
DISCORD_SECURITY_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ============================================================
# SECURITY API ENDPOINTS
# ============================================================

# Firewall Management API
FIREWALL_API=https://api.firewall.strategickhaos.ai

# Session Management Service
SESSION_SERVICE=https://api.sessions.strategickhaos.ai

# Identity and Access Management API
IAM_API=https://api.iam.strategickhaos.ai

# Rate Limiting API
RATE_LIMIT_API=https://api.ratelimit.strategickhaos.ai

# User Quarantine API
QUARANTINE_API=https://api.quarantine.strategickhaos.ai

# Access Control API
ACCESS_CONTROL_API=https://api.access.strategickhaos.ai

# Credential Rotation Service
ROTATION_SERVICE_URL=https://api.rotate.strategickhaos.ai

# Webhook Management API
WEBHOOK_MGMT_API=https://api.webhooks.strategickhaos.ai

# Docker Management API
DOCKER_MGMT_API=https://api.docker.strategickhaos.ai

# CAPTCHA Service
CAPTCHA_SERVICE=https://api.captcha.strategickhaos.ai

# Incident Response API
INCIDENT_RESPONSE_API=https://api.ir.strategickhaos.ai

# ============================================================
# SLACK CONFIGURATION
# ============================================================

# Slack Workspace
SLACK_WORKSPACE=strategickhaos-rla5357.slack.com

# Slack Webhook URLs (one per channel)
SLACK_WEBHOOK_CRITICAL=https://hooks.slack.com/services/YOUR/CRITICAL/WEBHOOK
SLACK_WEBHOOK_HIGH=https://hooks.slack.com/services/YOUR/HIGH/WEBHOOK
SLACK_WEBHOOK_MEDIUM=https://hooks.slack.com/services/YOUR/MEDIUM/WEBHOOK
SLACK_WEBHOOK_LOW=https://hooks.slack.com/services/YOUR/LOW/WEBHOOK

# Slack Channel Names
SLACK_CHANNEL_CRITICAL=#security-critical
SLACK_CHANNEL_HIGH=#security-high
SLACK_CHANNEL_MEDIUM=#security-medium
SLACK_CHANNEL_LOW=#security-low

# ============================================================
# AIRTABLE CONFIGURATION
# ============================================================

# Airtable API Key
AIRTABLE_API_KEY=keyXXXXXXXXXXXXXX

# Airtable Base ID
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Airtable Table Names
AIRTABLE_INCIDENT_LOG=Incident_Log
AIRTABLE_DETECTION_LOG=Detection_Log
AIRTABLE_RECONNAISSANCE_LOG=Reconnaissance_Log

# ============================================================
# GOOGLE SHEETS CONFIGURATION
# ============================================================

# Google Sheets API Key
GOOGLE_SHEETS_API_KEY=YOUR_GOOGLE_SHEETS_API_KEY

# Reconnaissance Log Spreadsheet ID
RECONNAISSANCE_LOG_SPREADSHEET_ID=YOUR_SPREADSHEET_ID

# Sheet Names
GOOGLE_SHEET_PORT_SCANS=Port_Scans
GOOGLE_SHEET_DNS_PROBES=DNS_Probes
GOOGLE_SHEET_ROBOTS_ACCESS=Robots_Access
GOOGLE_SHEET_UA_ANOMALIES=UA_Anomalies

# ============================================================
# EMAIL CONFIGURATION
# ============================================================

# Security Team Email
SECURITY_EMAIL=security@strategickhaos.ai

# Email Service Configuration (if using SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@strategickhaos.ai
SMTP_PASS=YOUR_SMTP_PASSWORD

# ============================================================
# KNOWN GOOD VALUES (Detection Baselines)
# ============================================================

# GitHub Configuration
GITHUB_APP_ID=123456
GITHUB_ORG=strategickhaos-dao-llc

# Authorized Bot IDs (JSON array)
AUTHORIZED_BOT_IDS=["bot_id_1", "bot_id_2", "bot_id_3"]

# Known IP Ranges (CIDR notation, JSON array)
KNOWN_IP_RANGES=["10.0.0.0/8", "192.168.0.0/16", "172.16.0.0/12"]

# Search Engine IP Ranges (JSON array)
SEARCH_ENGINE_IPS=["66.249.0.0/16", "40.77.0.0/16", "207.46.0.0/16"]

# Authorized Countries (ISO codes, JSON array)
AUTHORIZED_COUNTRIES=["US", "CA", "GB", "EU"]

# High Risk Countries (ISO codes, JSON array)
HIGH_RISK_COUNTRIES=["XX", "YY", "ZZ"]

# ============================================================
# DETECTION THRESHOLDS
# ============================================================

# Rate Limiting Thresholds
API_RATE_LIMIT=1000
LOGIN_RATE_LIMIT=10
DOWNLOAD_RATE_LIMIT=100

# Port Scan Detection
PORT_SCAN_THRESHOLD=20

# DNS Query Threshold
DNS_QUERY_THRESHOLD=50

# Database Query Threshold
DB_QUERY_THRESHOLD=1000

# File Download Threshold (bytes)
BULK_DOWNLOAD_THRESHOLD=1073741824

# Concurrent Session Limit
MAX_CONCURRENT_SESSIONS=5

# Failed Login Threshold
FAILED_LOGIN_THRESHOLD=5

# ============================================================
# PAGERDUTY CONFIGURATION (Optional)
# ============================================================

# PagerDuty Integration
PAGERDUTY_API_KEY=YOUR_PAGERDUTY_API_KEY
PAGERDUTY_SERVICE_ID=YOUR_SERVICE_ID
PAGERDUTY_ESCALATION_POLICY=YOUR_ESCALATION_POLICY_ID

# ============================================================
# SPLUNK CONFIGURATION (Optional)
# ============================================================

# Splunk HTTP Event Collector
SPLUNK_HEC_URL=https://splunk.strategickhaos.ai:8088/services/collector
SPLUNK_HEC_TOKEN=YOUR_HEC_TOKEN

# ============================================================
# CANARY TOKEN CONFIGURATION
# ============================================================

# Canary Tokens Service
CANARY_TOKENS_URL=https://canarytokens.org/generate
CANARY_TOKENS_EMAIL=canary@strategickhaos.ai

# DNS Canary Domains (JSON array)
DNS_CANARY_DOMAINS=["internal-admin.strategickhaos.ai", "backup-db.strategickhaos.ai", "prod-secrets.strategickhaos.ai"]

# File Canary Paths (JSON array)
FILE_CANARY_PATHS=["/backup/.env.production", "/config/database_credentials.txt", "~/.aws/credentials_backup"]

# AWS Canary Users (JSON array)
AWS_CANARY_USERS=["canary-admin-user", "canary-backup-user"]

# ============================================================
# ZAPIER CONFIGURATION
# ============================================================

# Zapier Webhook Base URL
ZAPIER_WEBHOOK_BASE=https://hooks.zapier.com/hooks/catch

# Zapier Account ID
ZAPIER_ACCOUNT_ID=YOUR_ACCOUNT_ID

# Zapier Storage (for state management)
ZAPIER_STORAGE_KEY=detection_matrix_state

# ============================================================
# SECURITY SETTINGS
# ============================================================

# Webhook Signature Secret (for HMAC verification)
WEBHOOK_SIGNATURE_SECRET=YOUR_RANDOM_SECRET_KEY

# API Authentication Tokens
DETECTION_API_TOKEN=YOUR_API_TOKEN
RESPONSE_API_TOKEN=YOUR_RESPONSE_TOKEN

# Encryption Keys
DATA_ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY

# ============================================================
# MONITORING & LOGGING
# ============================================================

# Log Level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Enable Debug Mode
DEBUG_MODE=false

# Metrics Collection
ENABLE_METRICS=true
METRICS_ENDPOINT=https://metrics.strategickhaos.ai

# ============================================================
# OPERATIONAL SETTINGS
# ============================================================

# Automatic Response Actions
AUTO_BLOCK_ENABLED=true
AUTO_QUARANTINE_ENABLED=true
AUTO_ROTATION_ENABLED=false

# Alert Cooldown (seconds)
ALERT_COOLDOWN_CRITICAL=300
ALERT_COOLDOWN_HIGH=900
ALERT_COOLDOWN_MEDIUM=3600

# Incident Response Settings
AUTO_IR_TRIGGER_LAYERS=[36]
IR_ON_CALL_PHONE=+1-XXX-XXX-XXXX

# ============================================================
# NOTES
# ============================================================
#
# - Replace all YOUR_* placeholders with actual values
# - Keep this file secure and never commit to version control
# - Rotate all credentials every 90 days minimum
# - Test all integrations before production deployment
# - Document any custom configurations in team wiki
# - Review and update thresholds based on false positive rates
#
# ============================================================
