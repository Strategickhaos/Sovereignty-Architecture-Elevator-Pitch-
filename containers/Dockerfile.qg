FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir \
    numpy>=1.24.0 \
    scipy>=1.10.0 \
    astropy>=5.3.0

# Copy FlameLang physics modules
COPY src/flamelang_physics.py /app/
COPY src/anomaly_detector.py /app/

# Health check
CMD ["python", "-c", "from flamelang_physics import flamelang_physics_compile; print('FlameLang QG ready')"]
