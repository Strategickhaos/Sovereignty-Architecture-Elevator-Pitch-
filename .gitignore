# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
node_modules

# Java build artifacts
*.class
*.jar
*.war
*.ear
target/
.mvn/
*.log

# JDK installations
.local/jdks/

# Workspace data
workspace/

# === Sovereignty Architecture Additions ===

# Temporary files and build artifacts
/tmp/
*.tmp
*.temp
dist/
build/

# Vector Database
knowledge/vector_db/*.index
knowledge/vector_db/*.vectors

# Logs (keep structure, not data)
logs/*.log
logs/immunity/*.json
!logs/immunity/README.md

# Quarantine zone (security isolation)
quarantine/external/*
quarantine/binaries/*
!quarantine/external/.gitkeep
!quarantine/binaries/.gitkeep

# Energy pool data
src/lifecycle/energy_pool.bin

# Crossfire arena results
tests/arena/results/*.json
!tests/arena/results/.gitkeep

# AI model cache
.ai_cache/
.model_cache/

# Compiled FlameLang
*.flame.compiled
*.flame.o

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment and secrets
.env
.env.local
.env.*.local
*.key
*.pem

# Python
__pycache__/
*.py[cod]
.Python

# Coverage
htmlcov/
.coverage
.coverage.*

# Auto-generated files
*_generated.rs
*_generated.ts
*_generated.py

# Keep directory structure
!**/.gitkeep
