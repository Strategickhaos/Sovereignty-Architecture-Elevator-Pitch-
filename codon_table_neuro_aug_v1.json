      },
      "evolution_targets": [
        "Maximize seizure detection accuracy",
        "Minimize energy per inference",
        "Maximize genetic repair fidelity"
      ],
      "mutation_operators": [
        "Point mutation (single parameter)",
        "Crossover (recombine homologies)",
        "Insertion/deletion (add/remove correlation terms)"
      ],
      "output": "evolved_codons.json with optimal parameters"
