# SAGCO Plymouth Boot Splash Script
# Shows the Ratio Ex Nihilo emblem during boot

# Window dimensions
screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# Background
background_sprite = Sprite();
background_sprite.SetImage(Image("ratio_ex_nihilo.png"));

# Center the emblem
image_width = background_sprite.GetImage().GetWidth();
image_height = background_sprite.GetImage().GetHeight();

# Position in center
background_sprite.SetX(screen_width / 2 - image_width / 2);
background_sprite.SetY(screen_height / 2 - image_height / 2);
background_sprite.SetZ(-100000);

# Optional: Add text below emblem
text_sprite = Sprite();
text_sprite.SetPosition(screen_width / 2, screen_height * 0.8, 10000);

# Boot progress indicator (spinning)
progress_sprite = Sprite();
progress_sprite.SetPosition(screen_width / 2, screen_height * 0.9, 10000);

fun refresh_callback() {
    # Rotate progress indicator
    progress_sprite.SetZ(progress_sprite.GetZ() + 1);
}

Plymouth.SetRefreshFunction(refresh_callback);
