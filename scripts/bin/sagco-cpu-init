#!/bin/bash
#
# SAGCO CPU Module Interface Initialization
# Initializes interaction with sagco_cpu_mod kernel module
#
# Entity: Strategickhaos DAO LLC
#

set -e

DEVICE="/dev/sagco_cpu"

# Setup logging
log() {
    echo "[sagco-cpu-init] $1"
    logger -t sagco-cpu-init "$1"
}

# Check if module is loaded
check_module() {
    if lsmod | grep -q sagco_cpu_mod; then
        log "SAGCO CPU module is loaded"
        return 0
    else
        log "ERROR: SAGCO CPU module not loaded"
        return 1
    fi
}

# Check device file
check_device() {
    if [ -c "$DEVICE" ]; then
        log "Device file $DEVICE exists"
        ls -l "$DEVICE" | logger -t sagco-cpu-init
        return 0
    else
        log "ERROR: Device file $DEVICE not found"
        return 1
    fi
}

# Initialize CPU state
initialize_cpu() {
    log "Initializing SAGCO CPU state..."
    
    # Reset CPU state
    echo "reset" > "$DEVICE" 2>/dev/null || {
        log "WARNING: Could not reset CPU state"
    }
    
    # Read initial state
    if cat "$DEVICE" > /tmp/sagco-cpu-state.txt 2>/dev/null; then
        log "Initial CPU state:"
        cat /tmp/sagco-cpu-state.txt | logger -t sagco-cpu-init
    else
        log "WARNING: Could not read CPU state"
    fi
}

# Test CPU functionality
test_cpu() {
    log "Testing SAGCO CPU functionality..."
    
    # Send tick command
    echo "tick" > "$DEVICE" 2>/dev/null || {
        log "WARNING: Could not send tick command"
        return 1
    }
    
    # Verify tick incremented counter
    if cat "$DEVICE" | grep -q "Ratio Counter: 1"; then
        log "CPU test PASSED: Ratio counter incremented"
        return 0
    else
        log "WARNING: CPU test may have failed"
        return 1
    fi
}

# Main execution
main() {
    log "SAGCO CPU interface initialization starting"
    log "Entity: Strategickhaos DAO LLC | EIN: 39-2923503"
    log "Invention: INV-101 (SAGCO CPU Primitives Module)"
    
    # Check module and device
    if ! check_module; then
        log "ERROR: Module check failed"
        exit 1
    fi
    
    if ! check_device; then
        log "ERROR: Device check failed"
        exit 1
    fi
    
    # Initialize and test
    initialize_cpu
    test_cpu
    
    log "SAGCO CPU interface initialized successfully"
    log "Ring 0 primitives accessible via $DEVICE"
}

main "$@"
