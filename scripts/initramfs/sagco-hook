#!/bin/bash
#
# SAGCO initramfs Hook Script
# Copies SAGCO verification script into initramfs during update-initramfs
#

PREREQ=""

prereqs()
{
    echo "$PREREQ"
}

case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

. /usr/share/initramfs-tools/hook-functions

# Copy SAGCO verification script
if [ -f /usr/local/share/sagco/scripts/sagco-verify ]; then
    copy_exec /usr/local/share/sagco/scripts/sagco-verify /scripts/init-premount/
    chmod +x "${DESTDIR}/scripts/init-premount/sagco-verify"
fi

# Copy SAGCO kernel module if present
if [ -f "/lib/modules/$(uname -r)/extra/sagco_cpu_mod.ko" ]; then
    manual_add_modules sagco_cpu_mod
fi

exit 0
