// FlameLang: age category using chained comparisons
fn age_category(age: i32) -> string {
    if age < 0 {
        return "invalid";
    } else if age < 13 {
        return "child";
    } else if age < 20 {
        return "teen";
    } else if age < 65 {
        return "adult";
    } else {
        return "senior";
    }
}
