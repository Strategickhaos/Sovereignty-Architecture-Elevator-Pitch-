# Neon Database Environment Configuration
# Copy this to .env and fill in your actual values

# Neon Database Connection String
# Get this from: Neon Dashboard → Project → Connection Details
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-shiny-dream-a49u5n6p.us-east-1.aws.neon.tech/neondb?sslmode=require

# Neon API Key (optional, for CLI operations)
# Get this from: Neon Dashboard → Account → API Keys
NEON_API_KEY=your_neon_api_key_here
