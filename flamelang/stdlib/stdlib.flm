// Math functions
fn abs(x) {
    if (x < 0) {
        return 0 - x;
    } else {
        return x;
    }
}

fn max(a, b) {
    if (a > b) {
        return a;
    } else {
        return b;
    }
}

fn min(a, b) {
    if (a < b) {
        return a;
    } else {
        return b;
    }
}

