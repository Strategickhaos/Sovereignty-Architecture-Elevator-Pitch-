#!/bin/sh
# SBIP v1.0 Boot Verification Script
# Strategickhaos DAO LLC
# 
# This script runs during initramfs init-premount phase
# to verify system integrity before mounting the root filesystem.

set -e

PREREQ=""
prereqs() { 
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

# Source initramfs functions
. /scripts/functions

MANIFEST="/etc/sagco/manifest.sha256"

log_begin_msg "SBIP v1.0: Starting boot verification"

# Check if manifest exists
if [ ! -f "$MANIFEST" ]; then
    log_warning_msg "SBIP: Manifest not found at $MANIFEST"
    log_end_msg 0
    exit 0
fi

log_success_msg "SBIP: Manifest found, verifying system integrity..."

# Track verification results
verified=0
failed=0
missing=0

# Read and verify each entry in manifest
# Format: <hash> <binary_path>
while read -r line; do
    # Skip comments and empty lines
    case "$line" in
        \#*|"") continue ;;
    esac
    
    # Parse hash and binary path
    expected_hash=$(echo "$line" | awk '{print $1}')
    binary=$(echo "$line" | awk '{print $2}')
    
    # Skip if no binary path
    [ -z "$binary" ] && continue
    
    # Check if binary exists
    if [ -f "$binary" ]; then
        # Calculate actual hash
        actual_hash=$(sha256sum "$binary" 2>/dev/null | awk '{print $1}')
        
        if [ "$expected_hash" = "$actual_hash" ]; then
            verified=$((verified + 1))
            log_success_msg "  ✓ $binary"
        else
            failed=$((failed + 1))
            log_failure_msg "  ✗ VERIFICATION FAILED: $binary"
            log_failure_msg "    Expected: $expected_hash"
            log_failure_msg "    Actual:   $actual_hash"
        fi
    else
        missing=$((missing + 1))
        log_warning_msg "  ? Binary not found: $binary"
    fi
done < "$MANIFEST"

# Report results
log_success_msg "SBIP Verification Results:"
log_success_msg "  Verified: $verified"
[ $failed -gt 0 ] && log_failure_msg "  Failed: $failed"
[ $missing -gt 0 ] && log_warning_msg "  Missing: $missing"

if [ $failed -gt 0 ]; then
    log_failure_msg "SBIP: INTEGRITY VERIFICATION FAILED"
    log_failure_msg "System binaries have been modified!"
    # Don't panic - just log the failure
    # In production, you might want to drop to emergency shell
    # panic "SBIP integrity check failed"
else
    log_success_msg "SBIP: Boot verification complete - system integrity confirmed"
fi

log_end_msg 0
exit 0
